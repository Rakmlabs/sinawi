{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dev",
  "description": "Dev-only capability (vite dev server). Enabled by tauri.dev.conf.json; not part of release builds.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "updater:default",
    "process:allow-restart",
    "allow-open-devtools",
    "allow-server-version-status",
    "allow-permission-status",
    "allow-request-permission",
    "allow-computer-exec",
    "allow-computer-revoke",
    "allow-computer-stop",
    "allow-native-browser-supported",
    "allow-native-browser-open",
    "allow-native-browser-layout",
    "allow-native-browser-close",
    "allow-native-browser-history",
    "allow-native-browser-emulate",
    "allow-native-browser-devtools",
    "allow-native-browser-call",
    "allow-native-browser-poll",
    "allow-native-browser-screenshot",
    "allow-native-browser-dialog",
    "allow-native-browser-events",
    "allow-native-browser-downloads",
    "allow-native-browser-input"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:5188/*"
    ]
  }
}

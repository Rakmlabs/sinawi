{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Production capability for the Sinawi desktop window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:3001/*"
    ]
  }
}

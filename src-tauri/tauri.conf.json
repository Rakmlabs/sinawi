{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sinawi",
  "version": "../package.json",
  "identifier": "dev.sinawi.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5188",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sinawi",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 25 },
        "visible": false,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/server.cjs": "server.cjs",
      "resources/sinawi-mcp.mjs": "sinawi-mcp.mjs",
      "resources/sim-hid": "sim-hid",
      "resources/dist/": "dist/",
      "resources/node_modules/": "node_modules/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxNzU0NEE4QjZGQzJEODMKUldTRExmeTJxRVIxQVhqWG00b2NobjhIcTlsdEdYanM2bHRFOEZCQW1hOGpueDErV2gzL3ZvSDIK",
      "endpoints": [
        "https://github.com/Rakmlabs/sinawi/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}

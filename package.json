{
  "name": "sinawi",
  "private": true,
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rakmlabs/sinawi.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test server/*.test.ts src/*.test.ts src/updates/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "build:server": "node scripts/build-server.mjs",
    "start": "node src-tauri/resources/server.cjs start",
    "app:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "app:build": "tauri build",
    "preapp:dev": "npm run build",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "eruda": "^3.4.3",
    "express": "5.2.1",
    "framer-motion": "12.42.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "0.563.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@tauri-apps/cli": "^2.12.4",
    "@types/express": "5.0.6",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.1.4",
    "esbuild": "0.27.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
